# --- Digibord AI Toverstudio ---
# Kopieer dit bestand naar `.env` en vul de sleutels in.

PORT=3000

# Bewaar elke omzetting in generated-images/: de tekening, het resultaat en de
# mp3, alle drie met dezelfde basisnaam inclusief de naam van het kind.
# Zet op false om niets op te slaan.
SAVE_IMAGES=true

# --- Prompt ---
# Deze twee gelden voor beide tekenmotoren; de naam FAL_ is historisch.
# De eerste regel van de prompt. Bewust zonder onderwerp: de tekening bepaalt
# wat er in de voorgrond staat, het thema alleen de wereld eromheen.
# FAL_LEAD=Convert this sketch into pixar style version, change this rough sketch into a proper image
# Stijltermen aan het eind. Kort houden: lange stijlreeksen overstemmen de
# tekening weer.
# FAL_STYLE=colourful, highly detailed, soft cinematic lighting, 3d render

# --- Tekenmotor ---
# gemini (standaard): begrijpt de schets. Een getekende raket wordt een raket,
#   met de raampjes en de vlam op hun plek. Geen cold starts, geen zwarte frames.
# fal: ControlNet of img2img. Volgt de compositie strakker maar weet niet wát er
#   staat. Gebruik dit als Gemini weigert of het quotum op is.
RENDER_ENGINE=gemini

# --- Fal.ai: alleen nodig bij RENDER_ENGINE=fal ---
FAL_KEY=jouw_fal_key
# Route. controlnet is de standaard: een text-to-image model waarbij de tekening
# alleen de structuur bepaalt en het model kleur, vacht, licht en achtergrond
# zelf verzint. img2img is de oude route (kleurt de tekening meer in).
FAL_MODE=controlnet

# Hoe leidend is de tekening (alleen bij controlnet). 0 = model negeert hem.
# Gemeten op een echte kleutertekening:
#   0.35 = model verzint bijna alles
#   0.50 = opzet blijft herkenbaar, beste balans (standaard)
#   0.65 = gaf een zwart beeld
FAL_CONTROL_SCALE=0.5

FAL_STEPS=30
FAL_GUIDANCE=8

# Via de queue-API insturen en op de status pollen, in plaats van één lange
# synchrone verbinding. Een cold start duurt tot ~70s en zo'n lange verbinding
# brak af met EADDRNOTAVAIL. Pollen kost geen credits, en een mislukte poll
# pakt dezelfde render weer op in plaats van een nieuwe te starten.
FAL_USE_QUEUE=true
FAL_MAX_WAIT_MS=180000

# Eén goedkope render bij het opstarten om het model warm te krijgen. Gemeten:
# cold start 147s, warm 4 tot 5s. Zet dit aan en start de server een paar
# minuten voor de les, dan valt die wachttijd buiten de les.
# Kost een fractie van je fal-tegoed, daarom standaard uit.
FAL_WARMUP=false

# Standaard modellen per route (meestal niet nodig om te zetten):
#   controlnet -> fal-ai/sdxl-controlnet-union
#   img2img    -> fal-ai/fast-sdxl/image-to-image
# FAL_MODEL=

# Alleen gebruikt als FAL_MODE=img2img.
# Verzachten verkleint de tekening naar dit raster en blaast hem weer op, zodat
# img2img kleurvlakken ziet in plaats van dunne lijnen. 0 zet het uit.
FAL_STRENGTH=0.90
FAL_SOFTEN=32

# Google Gemini.
# Wordt voor twee dingen gebruikt: het tekenen zelf (GEMINI_IMAGE_MODEL) en het
# verhaaltje van twee zinnen bij het plaatje (GEMINI_MODEL).
#
# Laat GEMINI_API_KEY leeg als je de sleutel al in een dotfile hebt staan. De
# server zoekt dan in deze volgorde: het bestand waar GEMINI_API_KEY_FILE naar
# wijst, ~/.gemini_api_key, ~/.config/gemini/api_key.
# GEMINI_API_KEY_FILE=/pad/naar/sleutelbestand
GEMINI_API_KEY=
# Tekstmodel voor de introductiezin. gemini-2.5-flash is uitgefaseerd (404).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- ElevenLabs ---
# Zonder sleutel leest de browser het verhaaltje voor met de ingebouwde stem.
ELEVENLABS_API_KEY=jouw_elevenlabs_key
ELEVENLABS_MODEL=eleven_multilingual_v2

# random = willekeurige stem uit ELEVENLABS_VOICE_POOL, nooit twee keer op rij
#          dezelfde. Werkt op een gratis plan.
# thema  = de ELEVENLABS_VOICE_ID_<THEMA> hieronder. Dat zijn library-stemmen
#          en die geven op een gratis plan 402 paid_plan_required.
ELEVENLABS_VOICE_MODE=random

# De 21 premade stemmen die op een gratis plan werken, getest met
# "Hallo, beste kinderen". Geen van deze is Nederlands: ze spreken Nederlands
# met een Engels accent.
#   pNInz6obpgDQGcFmaJgB  Adam - Dominant, Firm
#   Xb7hH8MSUJpSbSDYk0k2  Alice - Clear, Engaging Educator
#   hpp4J3VqNfWAUOO0d1Us  Bella - Professional, Bright, Warm
