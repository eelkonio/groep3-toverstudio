#   TX3LPaxmHKxFdv7VOQHJ  Liam - Energetic, Social Media Creator
#   pFZP5JQG7iQjIQuC4Bku  Lily - Velvety Actress
#   XrExE9yKIg1WjnnlVkGX  Matilda - Knowledgable, Professional
#   SAz9YHcvj6GT2YYXdXww  River - Relaxed, Neutral, Informative
#   CwhRBWXzGAHq8TQ4Fs17  Roger - Laid-Back, Casual, Resonant
#   EXAVITQu4vr4xnSDxMaL  Sarah - Mature, Reassuring, Confident
#   bIHbv24MWmeRgasZH58o  Will - Relaxed Optimist
ELEVENLABS_VOICE_POOL=pNInz6obpgDQGcFmaJgB,Xb7hH8MSUJpSbSDYk0k2,hpp4J3VqNfWAUOO0d1Us,pqHfZKP75CvOlQylNhV4,nPczCjzI2devNBz1zQrb,N2lVS1w4EtoT3dr4eOWO,IKne3meq5aSn9XLyUdCD,iP95p4xoKVk53GoZ742B,onwK4e9ZLuTAKqWW03F9,cjVigY5qzO86Huf0OWal,JBFqnCBsd6RMkjVDRZzb,SOYHLrjzK2X1ezoPC6cr,cgSgspJ2msm6clMCkdW9,FGY2WhTYpPnrIDTdsKH5,TX3LPaxmHKxFdv7VOQHJ,pFZP5JQG7iQjIQuC4Bku,XrExE9yKIg1WjnnlVkGX,SAz9YHcvj6GT2YYXdXww,CwhRBWXzGAHq8TQ4Fs17,EXAVITQu4vr4xnSDxMaL,bIHbv24MWmeRgasZH58o

# Stem per thema, alleen gebruikt bij ELEVENLABS_VOICE_MODE=thema.
# Vul hier je eigen voice-id's in.
ELEVENLABS_VOICE_ID=YypU2axAT21dZtyJyNGA
ELEVENLABS_VOICE_ID_DRAAK=LRpNiUBlcqgIsKUzcrlN
ELEVENLABS_VOICE_ID_FEE=aHC3XZOMg3HZuXVYK6hy
